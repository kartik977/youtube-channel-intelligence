# Rename to .dev.vars for `npm run dev:full`; never commit your real API key.
YOUTUBE_API_KEY=replace_with_your_api_key

# Optional AI mode: Groq Free tier; leave unset for built-in playbook mode.
# Create a key at https://console.groq.com/keys (never commit your real key).
# GROQ_API_KEY=replace_with_your_groq_key
# GROQ_MODEL=openai/gpt-oss-20b
